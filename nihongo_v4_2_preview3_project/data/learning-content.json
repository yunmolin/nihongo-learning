  "grammar": [
    {
      "id": "grammar-n5-desu",
      "title": "A は B です",
      "structure": "主題 ＋ は ＋ 名詞 ＋ です",
      "context": "介紹自己或說明身分",
      "explanation": "は提示主題，讀作 wa；です使名詞句帶有禮貌語氣。",
      "sentenceIds": [
        "sentence-n5-01"
      ],
      "knowledgePointIds": [
        "kp-n5-grammar-001"
      ]
    },
    {
      "id": "grammar-n5-no",
      "title": "名詞の名詞",
      "structure": "所有人／所屬 ＋ の ＋ 物品",
      "context": "說明東西是誰的",
      "explanation": "の在此連接所屬關係，先說所有人，再說物品。",
      "sentenceIds": [
        "sentence-n5-02"
      ],
      "knowledgePointIds": [
        "kp-n5-grammar-001"
      ]
    },
    {
      "id": "grammar-n5-de",
      "title": "動作場所で",
      "structure": "場所 ＋ で ＋ 動作",
      "context": "說明在哪裡做事",
      "explanation": "在圖書館讀書，圖書館是動作發生的場所，用で；不要與移動目的地に混淆。",
      "sentenceIds": [
        "sentence-n5-03"
      ],
      "knowledgePointIds": [
        "kp-n5-grammar-002"
      ]
    },
    {
      "id": "grammar-n5-to",
      "title": "同行者と",
      "structure": "同行者 ＋ と ＋ 動作",
      "context": "表示和某人一起",
      "explanation": "友だちと表示和朋友一起。本句的と不是引用用法。",
      "sentenceIds": [
        "sentence-n5-04"
      ],
      "knowledgePointIds": [
        "kp-n5-grammar-002"
      ]
    },
    {
