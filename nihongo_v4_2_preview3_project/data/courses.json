          "老師"
        ],
        [
          "本",
          "ほん",
          "書"
        ]
      ],
      "grammar": [
        {
          "title": "A は B です",
          "explanation": "は標示主題，這裡讀作 wa；です讓名詞句帶有禮貌語氣。",
          "example": "わたしは学生です。",
          "translation": "我是學生。"
        },
        {
          "title": "名詞の名詞",
          "explanation": "の可表示所屬。先說所有人，再說物品。",
          "example": "これは田中さんの本です。",
          "translation": "這是田中先生的書。"
        }
      ],
      "commonMistakes": [
        "助詞は在這裡讀 wa，不讀 ha。",
        "不要把「我的書」寫成わたし本，需加の。"
      ],
