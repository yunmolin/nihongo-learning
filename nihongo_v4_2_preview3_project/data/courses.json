        ],
        [
          "休み",
          "やすみ",
          "休息、休館日"
        ]
      ],
      "grammar": [
        {
          "title": "でも：轉折",
          "explanation": "前後情況不同時，用でも連接。讀題時特別留意轉折後的資訊。",
          "example": "毎日バスで行きます。でも、今日は歩いて行きました。",
          "translation": "每天搭巴士去，但今天走路去了。"
        },
        {
          "title": "から～まで：起訖",
          "explanation": "から表示開始，まで表示結束，可用於時間或地點範圍。",
          "example": "午前九時から午後五時までです。",
          "translation": "從上午九點到下午五點。"
        }
      ],
      "commonMistakes": [
        "不要把平常的交通方式直接當成今天的答案。",
